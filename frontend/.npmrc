# No lockfile is tracked in this repo (see .gitignore): disable generating
# one locally too. It otherwise gets written to the bind-mounted /app on every
# `npm install` (see publish.sh / Dockerfile.dev), and reading+writing that
# file through Docker Desktop for Mac's VirtioFS bind mount hits a known
# "Unknown system error -35" (ENOLCK) bug that crashes npm with
# ERR_INVALID_ARG_TYPE ("path" argument received null) while saving it.
package-lock=false
