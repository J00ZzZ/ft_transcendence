# Copy to .env, then run `make build` (or `make env`): it validates that every
# required value below is filled in (failing with a clear list otherwise).
# Nothing is auto-generated:
# copy a real .env from a teammate with the secrets filled in. This file itself
# is safe to commit: it holds no real secrets.

# ── database (required) ──────────────────
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PASSWORD=
DATABASE_URL=
CONTAINER_DATABASE_URL=

# ── redis (required) ──────────────────────
REDIS_PASSWORD=

# ── jwt / engine (required) ───────────────
# Three independent keys, one per token family, so one leaked key cannot forge
# another: JWT_SECRET signs session access tokens (cookie); ENGINE_JWT_SECRET
# signs the game-scoped Socket.IO tokens handed to ludo-engine;
# OAUTH_STATE_SECRET signs the oauth-link token carried in the OAuth `state`.
JWT_SECRET=
ENGINE_JWT_SECRET=
OAUTH_STATE_SECRET=
ENGINE_API_KEY=

# ── oauth: google (manual: required) ────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ── oauth: github (manual: required) ────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# ── oauth: 42 (manual: required) ────────────────────────────────────────────
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
FORTYTWO_CALLBACK_URL=

# ── ngrok tunnel mode (manual, all six required) ────────────────────────────
# `make env` validates all six on every build, and the backend reads
# NGROK_FRONTEND_URL + the three NGROK_*_CALLBACK_URL values at boot
# (requireSecret in the *-tunnel OAuth strategies), so none of them may be left
# empty even when you never run `make tunnel`.
#
# NGROK_PORT is the host port compose publishes for nginx's tunnel listener
# (127.0.0.1:8444 → 444). That publish has no profile, so the port is open in
# every mode and must be free for the stack to start. `make tunnel` points the
# ngrok agent at it, so keep it in step with the publish in compose.yaml.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
NGROK_PORT=8444
NGROK_FRONTEND_URL=
NGROK_GOOGLE_CALLBACK_URL=
NGROK_GITHUB_CALLBACK_URL=
NGROK_FORTYTWO_CALLBACK_URL=

# ── misc (FRONTEND_URL, HTTPS_PORT, SMTP_CREDENTIALS required; LAN_IP optional) ────────────────────────────────────────────────────────────
FRONTEND_URL=https://localhost:8443
# HTTPS_PORT is the host port nginx's direct TLS listener is published on
# (8443 → 443, every interface) and the port printed by `make all` / `make lan`.
HTTPS_PORT=8443
# SMTP_CREDENTIALS is required by `make env` (must be non-empty) and read once at
# boot by MailService in the form [host]:port address@example.com:app-password.
# Without it the backend still starts, but only logs verification emails.
SMTP_CREDENTIALS=
# LAN_IP is optional: `make lan` detects this machine's address and writes it here.
LAN_IP=
